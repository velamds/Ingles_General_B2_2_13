e": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn10le13ob04re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " \nPresent stress management techniques.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self-Assessment.\n", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn10le13ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: I talked to my supplier yesterday when he came into the restaurant.  He guaranteed the shipment would be here at 4:00 pm. When does the engineering group arrive?<br/>\n<span class=\"strong\">Marcel</span>: 8:00 p.m.<br/>\n<span class=\"strong\">Vanessa</span>: What time is it now?<br/>\n<span class=\"strong\">Marcel</span>: It is 7:45.<br/>\n<span class=\"strong\">Vanessa</span>: Have you seen Rachel?<br/>\n<span class=\"strong\">Marcel</span>: I just called her on the phone. She said she's sick and can't come in.<br/>\n<span class=\"strong\">Vanessa</span>: Really! Where are Michael and Alexander?<br/>\n<span class=\"strong\">Marcel</span>: Rachel told me they were in a car accident.<br/>\n<span class=\"strong\">Vanessa</span>: WHAT? Why didn't they call me?<br/>\n<span class=\"strong\">Marcel</span>: I guess they were preoccupied.<br/>\n<span class=\"strong\">Vanessa</span>: Are they ok?<br/>\n<span class=\"strong\">Marcel</span>: They are a little  banged up, but ok. They are going to stay at home though as a precaution. Here comes the engineering group!<br/>\n<span class=\"strong\">Vanessa</span>: GREAT! We're short-handed three employees.   I'll take care of them, I need you to oversee the bar.", "id": 1, "time": "50", "image": "engenn10le13ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Welcome to Bistro 88. Are you with the Asian engineer committee?<br/>\n<span class=\"strong\">Mr. Wu</span>: Yes, we are.<br/>\n<span class=\"strong\">Vanessa</span>: And how many in your party?<br/>\n<span class=\"strong\">Mr. Wu</span>: Twenty-two. Two are late.<br/>\n<span class=\"strong\">Vanessa</span>: Come with me everyone.<br/><br/>\n<span class=\"strong\">Vanessa</span>: Hello, everyone. My name is Vanessa and I will be serving you this evening. So where is everybody from?<br/>\n<span class=\"strong\">Mr. Wu</span>: We are from all over Asia. We have Japanese, Chinese, Vietnamese, Korean and Cantonese from Hong Kong.<br/>\n<span class=\"strong\">Vanessa</span>: Well, welcome to Boston. Are all of you engineers?<br/>\n<span class=\"strong\">Mr. Wu</span>: No, we have two sightseers and I am a volunteer helping out. Could we start with some of your famous Bistro wine? I'll order for everybody.", "id": 2, "time": "45500", "image": "engenn10le13ob04re2img02.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Absolutely! Would you like white or red?<br/>\n<span class=\"strong\">Mr. Wu</span>: Three bottles of red.<br/>\n<span class=\"strong\">Vanessa</span>: Would you like Merlot or Sauvignon?<br/>\n<span class=\"strong\">Mr. Wu</span>: I'd like Sauvignon, please.<br/>\n<span class=\"strong\">Vanessa</span>: Would you like cheese and crackers?<br/>\n<span class=\"strong\">Mr. Wu</span>: Yes, please.<br/>\n<span class=\"strong\">Vanessa</span>: Great! I'll be right back.<br/>\n<span class=\"strong\">Marcel</span>: Here is the supplier.<br/>\n<span class=\"strong\">Vanessa</span>: Tell your boss he's fired!", "id": 3, "time": "85500", "image": "engenn10le13ob04re2img01.jpg"}], "audiosrc": "engenn10le13ob04re2aud01", "coverimg": "engenn10le13ob04re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}